# ===== CORE =====
DATABASE_URL=mongodb+srv://user:pass@cluster0.abcde.mongodb.net/synapse?retryWrites=true&w=majority
PORT=4000
JWT_SECRET=synapsesecret123

# Set to "production" on a deployed instance. This switches the auth cookie to
# SameSite=None; Secure, which browsers require when the SPA and API are on
# different sites (e.g. Vercel frontend + Render backend).
NODE_ENV=development

# Comma-separated list of allowed browser origins. Must include the deployed
# frontend URL in production. Never use "*" — credentials are enabled.
CORS_ORIGIN=http://localhost:3000

# Public frontend URL used in links sent by email, such as password resets.
# Do not include a trailing slash.
CLIENT_URL=http://localhost:3000

# ===== MAIL (Nodemailer / SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_USER=test@gmail.com
MAIL_PASS=testpass123
# Optional — inbox that receives contact-form submissions. Falls back to MAIL_USER.
CONTACT_MAIL_TO=

# ===== CLOUDINARY (media uploads) =====
CLOUD_NAME=your-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret
FOLDER_NAME=Synapse

# ===== RAZORPAY (payments) =====
# Test Mode keys (rzp_test_*) are free and need no KYC.
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_SECRET=your-razorpay-secret
# REQUIRED: enrollments are granted only by a verified webhook.
# Set the same secret in Razorpay Dashboard > Accounts & Settings > Webhooks.
# URL: https://<public-backend>/api/v1/payment/verifySignature
# Subscribe to payment.captured (order.paid is also supported).
# Enable automatic payment capture in the dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ===== GEMINI API =====
# Leave as the placeholder to run the Doubt Assistant in stub mode.
GEMINI_API_KEY = "<your-key-here>"
GEMINI_MODEL = "gemini-flash-latest"
